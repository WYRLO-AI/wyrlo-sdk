{
  "name": "@wyrlo/sdk",
  "version": "0.1.2",
  "description": "Stop RAG hallucinations: verify LLM answers against their sources and say \"I don't know\" instead of guessing.",
  "license": "Apache-2.0",
  "author": "Mayeul FLORY, entrepreneur individuel (FUSION-IA) <contact@wyrlo.io>",
  "homepage": "https://www.wyrlo.io",
  "bugs": {
    "url": "https://github.com/WYRLO-AI/wyrlo-sdk/issues"
  },
  "keywords": [
    "rag",
    "llm",
    "hallucination",
    "hallucination-detection",
    "guardrails",
    "llm-guardrails",
    "grounding",
    "fact-checking",
    "retrieval-augmented-generation",
    "ai-safety",
    "prompt-injection",
    "wyrlo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "default": "./dist/documents.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node scripts/confirm-publish.mjs && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "pdfjs-dist": "^6.5.438",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRLO-AI/wyrlo-sdk.git",
    "directory": "typescript"
  }
}
