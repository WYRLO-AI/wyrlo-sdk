{
  "name": "@wyrlo/mcp",
  "mcpName": "io.github.WYRLO-AI/wyrlo",
  "version": "0.1.0",
  "description": "MCP server for WYRLO: agents verify their answers against their sources and say \"I don't know\" instead of guessing.",
  "license": "Apache-2.0",
  "author": "Mayeul FLORY, entrepreneur individuel (FUSION-IA) <contact@wyrlo.io>",
  "homepage": "https://www.wyrlo.io",
  "bugs": {
    "url": "https://github.com/WYRLO-AI/wyrlo-sdk/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rag",
    "llm",
    "agents",
    "ai-agents",
    "hallucination",
    "guardrails",
    "grounding",
    "wyrlo"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "wyrlo-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node scripts/confirm-publish.mjs && npm run build && npm test"
  },
  "dependencies": {
    "@wyrlo/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRLO-AI/wyrlo-sdk.git",
    "directory": "mcp"
  }
}
